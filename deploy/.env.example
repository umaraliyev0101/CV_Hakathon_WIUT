# Copy to deploy/.env (gitignored) and edit. Every line is optional.

# Password for the whole site. Strongly recommended before `up.sh --public`: neither app has accounts.
DEMO_USER=
DEMO_PASS=

# ngrok: the token defaults to NGROK_TOKEN in the repo-root .env, then ~/.config/ngrok/ngrok.yml. NGROK_DOMAIN = your static domain, if any.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Our fine-tuned RF-DETR Nano (models/*.onnx is mounted read-only at /opt/ft in both apps).
# Leave empty to keep each app's benchmarked default detector.
SHOWROOM_RFDETR_FT=
SHOWROOM_DETECTOR=
SHOWROOM_LIVE_DETECTOR=
PULSE_RFDETR_FT=

# Local port of the nginx front (127.0.0.1 only) and CPU cores per app.
WEB_PORT=8090
APP_CPUS=16

# Inference device: cuda (default, GPU_ID) or cpu.
ORT_DEVICE=cuda
GPU_ID=1
